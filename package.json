    "esbuild": "^0.27.2",
    "events": "^3.3.0",
    "informa": "^5.0.7",
    "koffi": "^2.14.0",
    "node-abi": "^4.34.0",
    "ses": "^2.3.0",
    "xml-parser": "^1.2.1",
    "zod": "^4.2.1"
  },
