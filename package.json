{
  "name": "@cathodique/de",
  "version": "1.0.1",
  "description": "Cathodique Desktop Environment",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && LOGGERS=wl_serv_i8a56qb0lm3ox1ng1cqai0e1 electron .",
    "test": "npx tsc -p tests/tsconfig.json && node dist/tests/test-module-system.js",
    "build-asset-homomorphic": "rm -frfr dist && mkdir dist && cp -frfr src/* dist/ && find dist/ -name \"*.ts\" -type f -delete",
    "build-source": "node build.mjs",
    "build-bin": "npx electron-rebuild",
    "build": "concurrently \"npm run build-source\" \"npm run build-bin\""
  },
