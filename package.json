  },
  "homepage": "https://github.com/cathodique/de#readme",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/electron": "^1.4.38",
    "@types/events": "^3.0.3",
    "@types/node": "^26.4.0",
    "concurrently": "^9.2.1",
    "prettier": "3.7.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@cathodique/mmap-io": "file:../mmap-io",
