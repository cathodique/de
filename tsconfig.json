{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",

    /* Modules */
    "module": "Node16",
    "rootDir": "./src",
    "moduleResolution": "nodenext",
    "baseUrl": "./src",
    "paths": {
      "@cathodique/*": [
        "renderer/modules/cathodique/*",
        "renderer/modules/cathodique/*/index.ts"
      ]
    },
    "types": ["ses"],

    /* Emit */
    "declaration": true,
    "outDir": "./dist",

    /* Interop Constraints */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
